.DS_Store
.env
.venv/
.zcode/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/
outputs/
# synthesized SFX are regenerated by scripts/make_voice_sfx.py; keep ATTRIBUTION.txt
src/petgen/resources/_sfx/*.wav
# local/regenerated batch prompt lists (batch20.tsv is the curated default
# manifest referenced by scripts/batch_generate.sh, so it stays tracked;
# larger or one-off remakes are generated and curated locally).
scripts/batch_remake*.tsv
scripts/batch[0-9][0-9].tsv
# keep the curated default checked in:
!scripts/batch20.tsv
